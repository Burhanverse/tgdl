PORT=8080
LOG_LEVEL=info

# Redis cache (optional, uses in-memory if not set)
REDIS_URI=redis://localhost:6379

# Stream cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_STREAMS=3600

# Scraper timing settings (in milliseconds)
SCRAPER_PROVIDER_TIMEOUT_MS=20000
SCRAPER_EARLY_RETURN_MS=20000
SCRAPER_HARD_TIMEOUT_MS=25000
SCRAPER_MIN_EARLY_RESULTS=20
